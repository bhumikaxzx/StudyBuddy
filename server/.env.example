# StudyBuddy real AI backend (Google Gemini)
PORT=8787

# Create an API key in Google AI Studio and paste it in server/.env.
# Never put this key in React/Vite frontend code or commit .env to GitHub.
GEMINI_API_KEY=

# Current default for new Gemini API projects. Change this if your API project has access to another model.
GEMINI_MODEL=gemini-3.8-flash
